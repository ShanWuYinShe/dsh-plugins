{
  "name": "dsh-plugins",
  "private": true,
  "description": "DSH host 层插件集：sandbox-extra-roots（沙盒额外目录）/ adaptive-perf（极简性能自适应）/ session-archive（归档会话管理）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winliyou/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "session-archive",
    "archive"
  ],
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:ci": "pnpm run build && pnpm run typecheck && vitest run",
    "gate": "node scripts/publish-gate.mjs",
    "adapt": "node scripts/adapt-dsh.mjs",
    "dsh-status": "node scripts/dsh-follow-status.mjs"
  }
}
