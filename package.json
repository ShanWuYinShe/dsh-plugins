{
  "name": "dsh-plugins",
  "private": true,
  "description": "DSH host 层插件集：sandbox-extra-roots（沙盒额外目录）/ session-archive（归档会话管理）/ dsh-any-connect（WorkBuddy 模型接入）/ provider-usage（provider 额度显示）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "session-archive",
    "archive",
    "sandbox",
    "workbuddy",
    "any-connect",
    "provider-usage",
    "quota",
    "usage"
  ],
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-generator": "^0.2.2-alpha.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typert": "node scripts/typert.mjs",
    "market:plan": "node scripts/plugin-market.mjs plan",
    "market:build": "node scripts/plugin-market.mjs build --out .workwork/plugin-market-site",
    "market:check": "node scripts/plugin-market.mjs check --out .workwork/plugin-market-site",
    "typecheck": "node scripts/typert.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/build.mjs && vitest run",
    "test:ci": "bun run build && bun run typecheck && vitest run",
    "gate": "node scripts/publish-gate.mjs",
    "adapt": "node scripts/adapt-dsh.mjs",
    "dsh-status": "node scripts/dsh-follow-status.mjs",
    "audit": "node scripts/audit-deps.mjs"
  }
}
