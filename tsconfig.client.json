{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["react"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["packages/*/client/**/*.tsx", "packages/*/client/**/*.ts"]
}
