{
  "name": "@chaoset/provider-usage",
  "version": "0.2.1-alpha.0",
  "description": "DSH plugin: show the current LLM provider's remaining quota in the composer dock — a generic querier registry any provider plugin can extend",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./typert": "./lib/typert.host.js"
  },
  "dsh": {
    "host": "0.2.2-alpha.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-resources": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-deepseek-account": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-alpha.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git",
    "directory": "packages/provider-usage"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ShanWuYinShe/dsh-plugins/issues"
  },
  "homepage": "https://github.com/ShanWuYinShe/dsh-plugins/tree/main/packages/provider-usage#readme"
}
