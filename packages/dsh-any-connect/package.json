{
  "name": "@chaoset/dsh-any-connect",
  "version": "0.4.28-alpha.9",
  "description": "DSH plugin: bring models offered by WorkBuddy-style desktop agents into DeepSeek Harness — zero configuration, per-model thinking effort, and billing rate at a glance",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-any-connect": "./lib/bin.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git",
    "directory": "packages/dsh-any-connect"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.7-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-json": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1",
    "@earendil-works/pi-ai": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  },
  "bugs": {
    "url": "https://github.com/ShanWuYinShe/dsh-plugins/issues"
  },
  "homepage": "https://github.com/ShanWuYinShe/dsh-plugins/tree/main/packages/dsh-any-connect#readme"
}
