{
  "name": "@chaoset/dsh-any-connect",
  "version": "0.3.18-alpha.1",
  "description": "DSH plugin: bring models offered by WorkBuddy-style desktop agents into DeepSeek Harness — zero configuration, per-model thinking effort, and billing rate at a glance",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-any-connect": "./lib/bin.js"
  },
  "dsh": {
    "host": "0.1.6-alpha.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.6-alpha.1",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winliyou/dsh-plugins.git",
    "directory": "packages/dsh-any-connect"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-authorization": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-fs": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-timeout": "^0.1.6-alpha.1",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/winliyou/dsh-plugins/issues"
  },
  "homepage": "https://github.com/winliyou/dsh-plugins/tree/main/packages/dsh-any-connect#readme"
}
