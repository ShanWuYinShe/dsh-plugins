{
  "name": "@chaoset/adaptive-perf",
  "version": "0.10.8",
  "description": "DSH host plugin: bring standard / PTC presets to minimal-mode-level performance — real Minimal tool pair, permanent injected-context suppression with on-demand discovery, runtime-context suppression, and adaptive tool-catalog trimming with demand-driven escalation",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "host": "0.1.5-rc.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-terminal": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-terminal-bash": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-bash-persistent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-str-replace-editor": "^0.1.5-rc.2"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winliyou/dsh-plugins.git",
    "directory": "packages/adaptive-perf"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/winliyou/dsh-plugins/issues"
  },
  "homepage": "https://github.com/winliyou/dsh-plugins/tree/main/packages/adaptive-perf#readme"
}
