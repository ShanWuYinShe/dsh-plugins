{
  "name": "@chaoset/session-archive",
  "version": "0.3.32-alpha.5",
  "description": "DSH plugin: browse archived sessions, inspect their content, batch-restore or permanently delete them with multi-select",
  "engines": {
    "dsh": "0.2.2-alpha.2",
    "node": ">=24.9.0"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types.js",
    "lib/types.d.ts",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-query": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-title": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-workspace": "^0.2.2-alpha.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "vitest": "^4.1.12",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git",
    "directory": "packages/session-archive"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ShanWuYinShe/dsh-plugins/issues"
  },
  "homepage": "https://github.com/ShanWuYinShe/dsh-plugins/tree/main/packages/session-archive#readme"
}
