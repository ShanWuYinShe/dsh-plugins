{
  "name": "@chaoset/session-archive",
  "version": "0.3.14-alpha.4",
  "description": "DSH plugin: browse archived sessions, inspect their content, batch-restore or permanently delete them with multi-select",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "host": "0.1.7-alpha.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-scope": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-title": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.7-alpha.1"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git",
    "directory": "packages/session-archive"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ShanWuYinShe/dsh-plugins/issues"
  },
  "homepage": "https://github.com/ShanWuYinShe/dsh-plugins/tree/main/packages/session-archive#readme"
}
