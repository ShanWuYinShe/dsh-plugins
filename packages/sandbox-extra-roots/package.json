{
  "name": "@chaoset/sandbox-extra-roots",
  "version": "0.4.31",
  "description": "DSH host plugin: extra writable roots for the workspace-write sandbox (Seatbelt/bwrap/Landlock profiles and the fs fence)",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types.js",
    "lib/types.d.ts",
    "client/client.cjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.1",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "@types/react-dom": "^19.3.0",
    "react-dom": "^19.3.1",
    "react": "^19.3.1",
    "vitest": "^4.1.12",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git",
    "directory": "packages/sandbox-extra-roots"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ShanWuYinShe/dsh-plugins/issues"
  },
  "homepage": "https://github.com/ShanWuYinShe/dsh-plugins/tree/main/packages/sandbox-extra-roots#readme"
}
