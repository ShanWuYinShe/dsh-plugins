{
  "name": "@chaoset/sandbox-extra-roots",
  "version": "0.4.15",
  "description": "DSH host plugin: extra writable roots for the workspace-write sandbox (Seatbelt/bwrap/Landlock profiles and the fs fence)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.cjs",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "host": "0.1.7-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.1.7-rc.1"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.1",
    "@deepseek-ai/node-addon-landlock-run": "^0.1.1"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/build.mjs && vitest run",
    "prepublishOnly": "bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShanWuYinShe/dsh-plugins.git",
    "directory": "packages/sandbox-extra-roots"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ShanWuYinShe/dsh-plugins/issues"
  },
  "homepage": "https://github.com/ShanWuYinShe/dsh-plugins/tree/main/packages/sandbox-extra-roots#readme"
}
